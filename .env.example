# Network this dApp targets. Must match the network selected in Lace.
VITE_NETWORK_ID=preprod

# Address of your deployed Counter contract on the network above.
# REQUIRED — the circuit call is disabled without it.
VITE_CONTRACT_ADDRESS=

# Optional: override the indexer the wallet reports.
# VITE_INDEXER_URI=https://indexer.preprod.midnight.network/api/v4/graphql
# VITE_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Optional: where ZK artifacts (keys/, zkir/) are served from.
# Defaults to <origin>/managed, populated from managed/ at build time.
# VITE_ZK_CONFIG_BASE_URL=
