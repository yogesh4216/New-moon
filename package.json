{
  "name": "midnight-counter-dapp",
  "version": "2.0.0",
  "type": "module",
  "description": "Midnight Builder Challenge Level 2 - private counter dApp with in-browser ZK proofs",
  "license": "MIT",
  "scripts": {
    "compile": "compact compile contracts/counter.compact managed",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup": "tsx src/setup.ts",
    "deploy": "tsx src/deploy.ts",
    "deploy:counter": "tsx src/deploy-counter.ts",
    "cli": "tsx src/cli.ts",
    "check-balance": "tsx src/check-balance.ts",
    "network": "tsx src/network.ts",
    "proof-server:start": "docker compose up -d proof-server",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf dist node_modules/.vite",
    "predev": "node scripts/copy-zk-artifacts.mjs",
    "prebuild": "node scripts/copy-zk-artifacts.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy",
    "compact"
  ]
}
